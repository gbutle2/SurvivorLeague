# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key only — safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Never put the service-role / secret key in NEXT_PUBLIC_* variables.
# Do not commit real values. Use Vercel project env settings for production.
